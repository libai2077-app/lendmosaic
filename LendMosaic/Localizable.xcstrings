    "Dates are records only. No reminders or messages are sent.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dates are records only. No reminders or messages are sent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付は記録のみです。通知やメッセージは送信しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날짜는 기록용입니다. 알림이나 메시지를 보내지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fechas son solo registros. No se envían recordatorios ni mensajes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dates servent au suivi. Aucun rappel ni message n'est envoyé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Daten dienen nur der Erfassung. Keine Erinnerungen oder Nachrichten."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As datas são apenas registros. Não são enviados lembretes ou mensagens."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le date sono solo registrazioni. Nessun promemoria o messaggio viene inviato."
          }
        }
      }
    },
    "Enter item, borrower and category. Dates must follow the lending date.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter item, borrower and category. Dates must follow the lending date."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "品物、借り手、分類を入力してください。期限と返却日は貸出日以降にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물건, 대여자, 분류를 입력하세요. 날짜는 대여일 이후여야 합니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica objeto, prestatario y categoría. Las fechas deben ser posteriores al préstamo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez objet, emprunteur et catégorie. Les dates doivent suivre le prêt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gegenstand, Entleiher und Kategorie eingeben. Daten müssen ab dem Leihtag liegen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira item, pessoa e categoria. As datas devem ser a partir do empréstimo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci oggetto, destinatario e categoria. Le date devono seguire il prestito."
          }
        }
      }
    },
