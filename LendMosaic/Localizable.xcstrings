    "Completion tracks recorded issues only. It does not certify the document is error-free.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Completion tracks recorded issues only. It does not certify the document is error-free."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了率は登録項目のみを対象とし、原稿に誤りがないことを保証しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료율은 기록된 문제만 추적하며 문서에 오류가 없음을 보증하지 않습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El progreso solo abarca los problemas registrados. No garantiza que el documento no tenga errores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le suivi couvre uniquement les points saisis et ne garantit pas un document sans erreurs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Fortschritt umfasst nur erfasste Punkte und bestätigt keine Fehlerfreiheit."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O progresso abrange apenas os itens registrados e não garante ausência de erros no documento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il completamento riguarda solo i problemi registrati e non certifica l'assenza di errori."
          }
        }
