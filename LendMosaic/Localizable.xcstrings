            "state": "translated",
            "value": "Il costo usa il prezzo per scatola nella tua valuta."
          }
        }
      }
    },
    "Each surface rounds up separately. No offcut reuse or opening deductions. Grid preview is capped; counts are exact for entered dimensions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each surface rounds up separately. No offcut reuse or opening deductions. Grid preview is capped; counts are exact for entered dimensions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "面ごとに切り上げ、端材再利用や開口部控除は含みません。図の表示数には上限がありますが、枚数は入力寸法で算出します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "면마다 올림합니다. 자투리 재사용과 개구부 공제는 제외됩니다. 격자 미리보기는 제한되지만 수량은 입력 치수로 계산됩니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se redondea cada superficie. No se reutilizan recortes ni se descuentan huecos. La vista de cuadrícula es limitada; el recuento usa las medidas indicadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque surface est arrondie séparément. Sans réemploi des chutes ni déduction des ouvertures. L'aperçu est limité ; les quantités suivent les dimensions saisies."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Fläche wird einzeln aufgerundet. Keine Reststücknutzung oder Abzüge für Öffnungen. Die Vorschau ist begrenzt; Mengen folgen den eingegebenen Maßen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada superfície é arredondada separadamente. Sem reutilizar recortes ou descontar aberturas. A prévia é limitada; a contagem usa as medidas inseridas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni superficie è arrotondata separatamente. Nessun riuso degli scarti o detrazione delle aperture. Anteprima limitata; conteggi basati sulle misure inserite."
          }
        }
      }
    },
    "Order each tile specification separately.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Order each tile specification separately."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイル規格ごとに注文してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타일 규격별로 따로 주문하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide cada tipo de baldosa por separado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commandez chaque référence séparément."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Fliesensorte getrennt bestellen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compre cada especificação separadamente."
          }
        },
        "it": {
