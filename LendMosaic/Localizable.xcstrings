            "state": "translated",
            "value": "Ordina ogni formato separatamente."
          }
        }
      }
    },
    "Enter names and valid dimensions. Check every surface.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter names and valid dimensions. Check every surface."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前と有効な寸法を入力し、各面を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름과 유효한 치수를 입력하고 모든 면을 확인하세요."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce nombres y medidas válidas. Revisa cada superficie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez des noms et dimensions valides. Vérifiez chaque surface."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Namen und gültige Maße eingeben. Jede Fläche prüfen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira nomes e medidas válidas. Confira cada superfície."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci nomi e misure valide. Controlla ogni superficie."
          }
