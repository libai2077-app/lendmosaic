    "Records stay on this device. No account, ads or purchases.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records stay on this device. No account, ads or purchases."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録はこの端末に保存されます。アカウント、広告、課金はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록은 이 기기에 저장됩니다. 계정, 광고, 구매가 없습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los registros se guardan en este dispositivo. Sin cuenta, anuncios ni compras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données restent sur cet appareil. Sans compte, publicité ni achats."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einträge bleiben auf diesem Gerät. Ohne Konto, Werbung oder Käufe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os registros ficam neste dispositivo. Sem conta, anúncios ou compras."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati restano su questo dispositivo. Senza account, pubblicità o acquisti."
          }
        }
      }
    },
    "Delete this record?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this record?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この記録を削除しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기록을 삭제할까요?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar este registro?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer cette fiche ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Eintrag löschen?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir este registro?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare questo record?"
          }
        }
      }
    },
    "Unable to save. Your existing records are unchanged.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to save. Your existing records are unchanged."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存できません。既存の記録は変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장할 수 없습니다. 기존 기록은 변경되지 않았습니다."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar. Los registros existentes no han cambiado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrement impossible. Les données existantes sont inchangées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern nicht möglich. Vorhandene Einträge bleiben unverändert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar. Os registros existentes não foram alterados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvataggio non riuscito. I dati esistenti non sono cambiati."
          }
        }
      }
    },
    "Unable to read records. Restore the data file before editing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to read records. Restore the data file before editing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録を読み込めません。編集前にデータファイルを復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
