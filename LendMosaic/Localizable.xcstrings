    "Cost uses your price per box in your own currency.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cost uses your price per box in your own currency."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "費用は入力した箱単価と通貨に基づきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
